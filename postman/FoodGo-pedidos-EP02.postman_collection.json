  "item": [
    {
      "name": "01 Crear, consultar y actualizar",
      "item": [
        {
          "name": "01 Crear Pedido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/api/pedidos",
            "description": "Respuesta esperada: HTTP 201. Datos ficticios para la EP02.",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"cliente\": \"Camila Soto\",\n  \"restaurante\": \"La Cocina de Barrio\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.collectionVariables.set(\"runTag\", Date.now().toString(36).toUpperCase() + \"-\" + pm.variables.replaceIn(\"{{$randomUUID}}\").replace(/-/g, \"\").slice(0, 8).toUpperCase());",
                  "const ayer = Date.now() - 24*60*60*1000;",
                  "pm.collectionVariables.set(\"fechaDemo\", new Date(ayer).toISOString().slice(0,19));",
                  "pm.collectionVariables.set(\"fechaDemoActualizada\", new Date(ayer + 5*60*1000).toISOString().slice(0,19));",
                  "pm.collectionVariables.set(\"fechaDemoFinal\", new Date(ayer + 20*60*1000).toISOString().slice(0,19));",
                  "pm.collectionVariables.unset(\"parentId\");",
                  "pm.collectionVariables.unset(\"childId\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "pm.test(\"ID generado\", () => pm.expect(Number.isInteger(pm.response.json().id) && pm.response.json().id > 0).to.eql(true));",
                  "if (pm.response.code === 201) pm.collectionVariables.set(\"parentId\", pm.response.json().id);"
                ]
              }
            }
          ]
        },
        {
          "name": "02 Listar",
